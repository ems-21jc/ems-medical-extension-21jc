{
  "manifest_version": 3,
  "name": "EMS Medical Extension - 21JC",
  "version": "",
  "description": "Extension Chrome pour aider à la rédaction de dossier pour les joueurs des EMS du serveur 21 Jump Click",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://intra.21jumpclick.fr/*"
      ],
      "js": [
        "browser-polyfill.js",
        "dateFieldCompletion.js",
        "medicalFileCompletion.js",
        "bodyZoneCompletion.js",
        "medicalCheckupCompletion.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}