{
  "manifest_version": 3,
  "name": "EMS Medical Tools - 21JC",
  "version": "0.5.0",
  "description": "Extension Firefox pour aider à la rédaction de dossier pour les joueurs des EMS du serveur 21 JumpClick",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://intra.21jumpclick.fr/*"
      ],
      "js": [
        "browser-polyfill.js",
        "dateFieldCompletion.js",
        "medicalFileCompletion.js",
        "bodyZoneCompletion.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension-ems-21jc@21jumpclick.fr"
    }
  }
}